# FinalFrame Environment Variables
# Copy this file to .env.local and fill in your values

# Convex configuration
# Convex is the application data, workflow, auth, and media backend.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=your-deployment-name
CONVEX_SITE_URL=https://your-deployment.convex.site
# Keep this deployment key server-side only; never expose it as NEXT_PUBLIC_*.
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here


# Maintenance Mode Flag
# Reference: MASTER_PRD.md § 11 — Maintenance mode handling
MAINTENANCE_MODE=false

# AI Provider Keys
# Reference: Phase 7.1 — Runway Video Engine
OPENROUTER_API_KEY=your_openrouter_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here
BACHS_API_KEY=your_bachs_api_key_here
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_ENVIRONMENT=sandbox
BACHS_ALLOWED_CURRENCIES=NGN,USD
BACHS_WEBHOOK_TOLERANCE_SECONDS=300
BACHS_WEBHOOK_SECRET=your_bachs_webhook_secret_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional feature flags (all disabled unless explicitly enabled)
NEXT_PUBLIC_FF_PRODUCTION_STUDIO=true
NEXT_PUBLIC_FF_CONVEX_AUTH=true
NEXT_PUBLIC_FF_OPENROUTER_MEDIA=true
NEXT_PUBLIC_FF_MOTION_GRAPHICS=true
NEXT_PUBLIC_FF_STYLIZED_2D=false
NEXT_PUBLIC_FF_UGC_WORKFLOW=false
NEXT_PUBLIC_FF_CINEMATIC_WORKFLOW=false
NEXT_PUBLIC_FF_BACHS_PAYMENTS=false
NEXT_PUBLIC_FF_ADMIN_OPERATIONS=false

# OpenRouter model overrides. Keep model IDs in environment/config, not UI code.
OPENROUTER_AI_BRAIN_MODEL=openai/gpt-6-astra
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast
OPENROUTER_VALIDATOR_MODEL=google/gemini-3.8-flash
OPENROUTER_PLANNER_MODEL=openai/gpt-6-astra
OPENROUTER_AI_BRAIN_FALLBACK_MODELS=google/gemini-3.8-flash
OPENROUTER_PLANNER_FALLBACK_MODELS=anthropic/claude-fable-5.1
OPENROUTER_VIDEO_FALLBACK_MODELS=bytedance/seedance-2.0-fast,kwaivgi/kling-v3.0-std
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-transcribe
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini

# Legacy provider is disabled; production video uses OpenRouter.
RUNWAY_LEGACY_ENABLED=false

# Convex Auth email delivery (optional until a verified sender domain exists)
CONVEX_AUTH_EMAIL_ENABLED=false
CONVEX_AUTH_ZEPTOMAIL_TOKEN=
CONVEX_AUTH_FROM_EMAIL=

# Dedicated renderer callback (configure before enabling assembly jobs)
RENDER_WORKER_URL=
RENDER_WORKER_SHARED_SECRET=
ERROR_TRACKING_DSN=

# Explicit opt-in for the owner/admin development credit grant. Keep false or
# unset in production; this never creates a payment record.
FINALFRAME_TEST_CREDITS_ENABLED=false
