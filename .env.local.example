# FinalFrame Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Reference: BUILD_PHASES.md — Phase 0 Foundation requires authentication
# Convex is the application data and workflow backend.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=your-deployment-name
# Keep this deployment key server-side only; never expose it as NEXT_PUBLIC_*.
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Maintenance Mode Flag
# Reference: MASTER_PRD.md § 11 — Maintenance mode handling
MAINTENANCE_MODE=false

# AI Provider Keys
# Reference: Phase 7.1 — Runway Video Engine
OPENROUTER_API_KEY=your_openrouter_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here
BACHS_API_KEY=your_bachs_api_key_here
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=your_bachs_webhook_secret_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
